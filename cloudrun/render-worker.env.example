# Non-secret settings. Do not put credentials in this file.
DB_NAME=faceless48
APP_VERSION=1.20.14
USE_LOCAL_COMPOSE=1
NORMALIZE_CONCURRENCY=1
RENDER_JOB_CONCURRENCY=1
STOCK_SEARCH_TIMEOUT_S=20
STUCK_RENDER_TIMEOUT_S=900
RENDER_HEARTBEAT_INTERVAL_S=15
RENDER_WORKER_LOCK_LEASE_S=180
RENDER_WORKER_LOCK_HEARTBEAT_S=30
TIMELINE_FEATURES_ENABLED=0
LOG_LEVEL=INFO
PUBLIC_BACKEND_URL=https://faceless48.c3global.co

# KIE still-image generation is independent from the optional video-motion
# registry. Keep USE_PROVIDER_REGISTRY=0 unless a KIE video model is approved.
KIE_IMAGE_GENERATION_ENABLED=1
KIE_IMAGE_MODEL=nano-banana-2
KIE_IMAGE_RESOLUTION=1K
USE_PROVIDER_REGISTRY=0
KIE_MODELS_ENABLED=

# Override for every execution.
RENDER_JOB_ID=replace-per-execution
RENDER_EXECUTION_ID=replace-per-execution

# Store these in Secret Manager later; never commit their values:
# MONGO_URL, KIE_API_KEY, FAL_API_KEY, EMERGENT_LLM_KEY, HEYGEN_API_KEY
# PEXELS_API_KEY, PIXABAY_API_KEY
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
# R2_BUCKET_NAME, R2_PUBLIC_URL
